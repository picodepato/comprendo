{
  "rewrites": [
    { "source": "/api/votos", "destination": "/api/propuestas?votos=1" },
    { "source": "/api/entrar", "destination": "/api/cuenta?a=entrar" },
    { "source": "/api/registro", "destination": "/api/cuenta?a=registro" },
    { "source": "/api/salir", "destination": "/api/cuenta?a=salir" },
    { "source": "/api/estado", "destination": "/api/cuenta?a=estado" },
    { "source": "/api/temas", "destination": "/api/admin?t=temas" },
    { "source": "/api/perfiles", "destination": "/api/admin?t=perfiles" },
    { "source": "/api/votos", "destination": "/api/propuestas?votos=1" }
  ],
  "functions": {
    "api/duelo.js": { "includeFiles": "content/**/lecturas/*.json" }
  },
  "headers": [
    { "source": "/content/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
